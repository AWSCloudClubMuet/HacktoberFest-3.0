@inject CampusGigPortal.Services.IUserSessionService UserSession
@{
    var currentUser = await UserSession.GetCurrentUserAsync();
    var allUsers = await UserSession.GetAllUsersAsync();
}
<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Campus Gig & SkillSwap</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="flex flex-col min-h-full text-slate-800 antialiased selection:bg-indigo-500 selection:text-white">

    <!-- Top Navigation Bar -->
    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-slate-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                
                <!-- Brand / Logo -->
                <div class="flex items-center gap-8">
                    <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3 group">
                        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-violet-500 flex items-center justify-center text-white shadow-md shadow-indigo-100 group-hover:scale-105 transition-transform">
                            <!-- Graduation Cap SVG -->
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                            </svg>
                        </div>
                        <div>
                            <span class="text-xl font-extrabold tracking-tight bg-gradient-to-r from-indigo-600 to-violet-700 bg-clip-text text-transparent">CampusGig</span>
                            <span class="text-xs block text-slate-500 font-medium -mt-1">& SkillSwap Portal</span>
                        </div>
                    </a>

                    <!-- Navigation Links -->
                    <nav class="hidden md:flex items-center gap-1">
                        <a asp-controller="Home" asp-action="Index" class="px-3.5 py-2 text-sm font-semibold rounded-lg text-slate-700 hover:text-indigo-600 hover:bg-slate-100 transition-colors flex items-center gap-1.5">
                            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                            Dashboard
                        </a>
                        <a asp-controller="Gigs" asp-action="Index" class="px-3.5 py-2 text-sm font-semibold rounded-lg text-slate-700 hover:text-indigo-600 hover:bg-slate-100 transition-colors flex items-center gap-1.5">
                            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                            Explore Gigs
                        </a>
                        <a asp-controller="Gigs" asp-action="MyGigs" class="px-3.5 py-2 text-sm font-semibold rounded-lg text-slate-700 hover:text-indigo-600 hover:bg-slate-100 transition-colors flex items-center gap-1.5">
                            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                            My Gigs & Apps
                        </a>
                        <a asp-controller="Profiles" asp-action="Index" asp-route-id="@currentUser.Id" class="px-3.5 py-2 text-sm font-semibold rounded-lg text-slate-700 hover:text-indigo-600 hover:bg-slate-100 transition-colors flex items-center gap-1.5">
                            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                            My Profile
                        </a>
                    </nav>
                </div>

                <!-- Right Action Bar: Post Gig + Switch Persona -->
                <div class="flex items-center gap-3">
                    <a asp-controller="Gigs" asp-action="Create" class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-700 hover:to-violet-700 text-white text-sm font-semibold rounded-lg shadow-sm shadow-indigo-200 transition-all">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
                        </svg>
                        <span>Post a Gig</span>
                    </a>

                    <!-- 1-Click Student Persona Switcher for Hackathon Testing -->
                    <div class="relative bg-slate-100 p-1 rounded-xl flex items-center border border-slate-200">
                        <form asp-controller="Home" asp-action="SwitchUser" method="post" class="flex items-center m-0">
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <div class="flex items-center gap-2 px-2 py-0.5">
                                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                                <span class="text-xs font-medium text-slate-500 hidden sm:inline">Active Persona:</span>
                                <select name="userId" onchange="this.form.submit()" class="bg-white text-xs font-semibold text-slate-800 rounded-md border border-slate-300 py-1 px-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none cursor-pointer">
                                    @foreach (var user in allUsers)
                                    {
                                        if (user.Id == currentUser.Id)
                                        {
                                            <option value="@user.Id" selected>@user.Name (@user.Major)</option>
                                        }
                                        else
                                        {
                                            <option value="@user.Id">@user.Name (@user.Major)</option>
                                        }
                                    }
                                </select>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </header>

    <!-- Global Toast Alerts -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4 w-full">
        @if (TempData["Success"] != null)
        {
            <div class="flex items-center gap-3 p-4 bg-emerald-50 border border-emerald-200 rounded-xl text-emerald-800 text-sm shadow-sm">
                <svg class="w-5 h-5 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div class="font-medium">@TempData["Success"]</div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="flex items-center gap-3 p-4 bg-rose-50 border border-rose-200 rounded-xl text-rose-800 text-sm shadow-sm">
                <svg class="w-5 h-5 text-rose-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div class="font-medium">@TempData["Error"]</div>
            </div>
        }
    </div>

    <!-- Main Content Area -->
    <main class="flex-grow">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 mt-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
            <div class="flex items-center gap-2">
                <div class="w-6 h-6 rounded-lg bg-indigo-600 flex items-center justify-center text-white font-bold text-xs">C</div>
                <span>Campus Gig & SkillSwap Portal &bull; ASP.NET Core 8 MVC & Microsoft SQL Server</span>
            </div>
            <div class="flex items-center gap-4">
                <a asp-controller="Gigs" asp-action="Index" class="hover:text-indigo-600">All Gigs</a>
                <span>&bull;</span>
                <span class="text-slate-400">Mock API: <code class="bg-slate-100 px-1.5 py-0.5 rounded text-indigo-600">/api/gigs</code></span>
                <span>&bull;</span>
                <span>Active User: <strong>@currentUser.Name</strong> (@currentUser.Major)</span>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
@inject CampusGigPortal.Services.IUserSessionService UserSession
@{
    var currentUser = await UserSession.GetCurrentUserAsync();
    var allUsers = await UserSession.GetAllUsersAsync();
}
<!DOCTYPE html>
<html lang="en" class="h-full bg-[#FDFBF7]">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Campus Gig Portal</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'parchment': '#FDFBF7',
                        'oxford': '#0F172A',
                        'heritage-gold': '#D97706'
                    }
                }
            }
        }
    </script>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
    
    <style>
        body { font-family: 'Inter', sans-serif; }
        h1, h2, h3, .font-serif-header { font-family: 'Playfair Display', serif; }
    </style>
</head>
<body class="flex flex-col min-h-full text-slate-800 antialiased bg-[#FDFBF7]">

    <!-- Navigation Header -->
    <header class="sticky top-0 z-50 bg-[#0F172A] text-white shadow-md border-b border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16 sm:h-20 gap-2">
                
                <!-- Logo -->
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2 sm:gap-3 shrink-0">
                    <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-lg bg-amber-600/20 border border-amber-500/40 flex items-center justify-center text-amber-400 font-serif font-bold text-base sm:text-lg">
                        C
                    </div>
                    <div>
                        <span class="text-base sm:text-xl font-serif font-bold text-amber-100 block leading-tight">CampusGig</span>
                        <span class="text-[9px] sm:text-[10px] text-slate-400 font-medium uppercase tracking-wider block -mt-0.5">Academic Network</span>
                    </div>
                </a>

                <!-- Desktop Nav -->
                <nav class="hidden lg:flex items-center gap-1">
                    <a asp-controller="Home" asp-action="Index" class="px-3 py-2 text-xs font-semibold rounded-lg text-slate-200 hover:text-white hover:bg-slate-800 transition-colors">Dashboard</a>
                    <a asp-controller="Gigs" asp-action="Index" class="px-3 py-2 text-xs font-semibold rounded-lg text-slate-200 hover:text-white hover:bg-slate-800 transition-colors">Explore</a>
                    <a asp-controller="Gigs" asp-action="MyGigs" class="px-3 py-2 text-xs font-semibold rounded-lg text-slate-200 hover:text-white hover:bg-slate-800 transition-colors">My Engagements</a>
                    <a asp-controller="Profiles" asp-action="Index" asp-route-id="@currentUser.Id" class="px-3 py-2 text-xs font-semibold rounded-lg text-slate-200 hover:text-white hover:bg-slate-800 transition-colors">Profile</a>
                </nav>

                <!-- Action Bar & Persona Switcher -->
                <div class="flex items-center gap-2 sm:gap-3">
                    <a asp-controller="Gigs" asp-action="Create" class="inline-flex items-center gap-1 px-3 py-2 sm:px-4 sm:py-2.5 bg-amber-600 hover:bg-amber-700 text-white text-xs font-semibold rounded-lg transition-all shrink-0">
                        <span>+ Post</span>
                        <span class="hidden sm:inline"> Opportunity</span>
                    </a>

                    <div class="bg-slate-800 border border-slate-700 p-1 rounded-lg">
                        <form asp-controller="Home" asp-action="SwitchUser" method="post" class="m-0">
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <select name="userId" onchange="this.form.submit()" class="bg-slate-900 text-xs font-semibold text-slate-200 rounded border border-slate-700 py-1 px-1.5 sm:px-2 focus:outline-none cursor-pointer max-w-[120px] sm:max-w-[180px] truncate">
                                @foreach (var user in allUsers)
                                {
                                    if (user.Id == currentUser.Id)
                                    {
                                        <option value="@user.Id" selected>@user.Name (@user.Major)</option>
                                    }
                                    else
                                    {
                                        <option value="@user.Id">@user.Name (@user.Major)</option>
                                    }
                                }
                            </select>
                        </form>
                    </div>
                </div>

            </div>

            <!-- Mobile Sub-Navigation -->
            <div class="flex lg:hidden overflow-x-auto py-2 gap-2 border-t border-slate-800/80 scrollbar-none text-xs font-medium">
                <a asp-controller="Home" asp-action="Index" class="px-3 py-1 rounded bg-slate-800 text-slate-200 whitespace-nowrap">Dashboard</a>
                <a asp-controller="Gigs" asp-action="Index" class="px-3 py-1 rounded bg-slate-800 text-slate-200 whitespace-nowrap">Explore Gigs</a>
                <a asp-controller="Gigs" asp-action="MyGigs" class="px-3 py-1 rounded bg-slate-800 text-slate-200 whitespace-nowrap">My Gigs</a>
                <a asp-controller="Profiles" asp-action="Index" asp-route-id="@currentUser.Id" class="px-3 py-1 rounded bg-slate-800 text-slate-200 whitespace-nowrap">Profile</a>
            </div>
        </div>
    </header>

    <!-- Global Toast Alerts -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4 w-full">
        @if (TempData["Success"] != null)
        {
            <div class="flex items-center gap-3 p-3.5 bg-emerald-50 border border-emerald-200 rounded-xl text-emerald-900 text-xs shadow-sm">
                <span class="font-bold">✓</span>
                <div class="font-medium">@TempData["Success"]</div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="flex items-center gap-3 p-3.5 bg-rose-50 border border-rose-200 rounded-xl text-rose-900 text-xs shadow-sm">
                <span class="font-bold">✕</span>
                <div class="font-medium">@TempData["Error"]</div>
            </div>
        }
    </div>

    <!-- Main Content -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-400 border-t border-slate-800 mt-16 sm:mt-20 py-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-center sm:text-left">
            <div class="flex items-center gap-2">
                <span class="font-serif text-amber-200 font-bold">CampusGig Portal</span>
                <span>&bull; ASP.NET Core 8 MVC</span>
            </div>
            <div>
                <span>Scholar: <strong class="text-slate-200">@currentUser.Name</strong> (@currentUser.Major)</span>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
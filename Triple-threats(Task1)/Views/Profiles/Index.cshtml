@model CampusGigPortal.Models.ViewModels.ProfileViewModel
@{
    var u = Model.ProfileUser;
    ViewData["Title"] = $"{u.Name} - Student Scholar Profile";
}

<div class="max-w-6xl mx-auto py-4 sm:py-6">

    <!-- Profile Header Banner / Main Card -->
    <div class="bg-white rounded-2xl border border-slate-200/90 p-6 sm:p-8 lg:p-10 shadow-sm mb-6 sm:mb-8">
        <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
            
            <!-- User Identity Header -->
            <div class="flex items-center gap-4 sm:gap-5">
                <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-slate-900 text-amber-300 font-serif font-bold text-2xl sm:text-3xl flex items-center justify-center shadow-sm shrink-0 border border-slate-800">
                    @u.Name.Substring(0, 1)
                </div>
                <div>
                    <span class="inline-flex items-center gap-1.5 text-[10px] sm:text-xs font-semibold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700 mb-1.5">
                        <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                        Academic Scholar Profile
                    </span>
                    <h1 class="text-2xl sm:text-4xl font-serif font-bold text-slate-900 tracking-tight">@u.Name</h1>
                    <div class="text-xs font-medium text-slate-600 mt-1 flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-amber-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0112 20.055a11.952 11.952 0 01-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/></svg>
                        <span>@u.Major &bull; @u.Semester</span>
                    </div>
                </div>
            </div>

            <!-- Dynamic Stats Block -->
            <div class="flex items-center gap-3 bg-slate-50 border border-slate-200/80 rounded-2xl p-3 sm:p-4 w-full lg:w-auto justify-around sm:justify-start">
                <div class="text-center px-3 sm:px-4 border-r border-slate-200">
                    <span class="text-[10px] sm:text-xs font-bold uppercase text-slate-500 block tracking-wider">Rating</span>
                    <span class="text-xl sm:text-2xl font-serif font-bold text-amber-700 flex items-center justify-center gap-1 mt-0.5">
                        <svg class="w-4 h-4 sm:w-5 sm:h-5 text-amber-500 fill-amber-400" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
                        @Model.AverageRating.ToString("0.0")
                    </span>
                    <span class="text-[10px] text-slate-500 font-medium block mt-0.5">(@Model.ReviewsReceived.Count Reviews)</span>
                </div>
                <div class="text-center px-3 sm:px-4 border-r border-slate-200">
                    <span class="text-[10px] sm:text-xs font-bold uppercase text-slate-500 block tracking-wider">Posted</span>
                    <span class="text-xl sm:text-2xl font-serif font-bold text-slate-900 block mt-0.5">@Model.PostedGigs.Count</span>
                    <span class="text-[10px] text-slate-500 font-medium block mt-0.5">Gigs</span>
                </div>
                <div class="text-center px-3 sm:px-4">
                    <span class="text-[10px] sm:text-xs font-bold uppercase text-slate-500 block tracking-wider">Completed</span>
                    <span class="text-xl sm:text-2xl font-serif font-bold text-slate-900 block mt-0.5">@Model.CompletedGigs.Count</span>
                    <span class="text-[10px] text-slate-500 font-medium block mt-0.5">Tasks</span>
                </div>
            </div>
        </div>

        <!-- About Section -->
        <div class="mt-8 pt-6 border-t border-slate-100">
            <h3 class="flex items-center gap-1.5 text-xs font-bold text-slate-500 uppercase tracking-wider mb-2.5">
                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                Scholar Bio & Background
            </h3>
            <p class="text-xs sm:text-sm text-slate-700 leading-relaxed bg-slate-50 border border-slate-200/70 rounded-xl p-4">
                @u.Bio
            </p>
        </div>

        <!-- Skills Matrix Section -->
        <div class="mt-6">
            <h3 class="flex items-center gap-1.5 text-xs font-bold text-slate-500 uppercase tracking-wider mb-2.5">
                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
                Core Competencies & Skills
            </h3>
            <div class="flex flex-wrap gap-2">
                @foreach (var s in u.Skills)
                {
                    <span class="text-xs font-medium px-3 py-1 bg-amber-50 text-amber-800 rounded-lg border border-amber-200/80">
                        @s
                    </span>
                }
            </div>
        </div>
    </div>

    <!-- Peer Reviews Received Card -->
    <div class="bg-white rounded-2xl border border-slate-200/90 p-6 sm:p-8 shadow-sm">
        <div class="flex items-center justify-between mb-6 border-b border-slate-100 pb-4">
            <h2 class="text-xl font-serif font-bold text-slate-900 flex items-center gap-2">
                <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                </svg>
                Peer Feedback & Reviews (@Model.ReviewsReceived.Count)
            </h2>
            <span class="text-xs font-mono text-slate-400 hidden sm:inline">Feedback Log</span>
        </div>

        @if (!Model.ReviewsReceived.Any())
        {
            <div class="text-center py-8 text-slate-500 text-xs font-medium bg-slate-50 rounded-xl border border-slate-200/70 border-dashed">
                No peer reviews received yet.
            </div>
        }
        else
        {
            <div class="space-y-4">
                @foreach (var r in Model.ReviewsReceived)
                {
                    <div class="p-4 bg-slate-50/70 rounded-xl border border-slate-200/80">
                        <div class="flex items-center justify-between mb-2 pb-2 border-b border-slate-200/60">
                            <span class="font-semibold text-xs text-slate-800">
                                @r.Reviewer?.Name
                            </span>
                            <span class="inline-flex items-center gap-1 bg-amber-50 text-amber-800 font-bold text-xs border border-amber-200 px-2.5 py-0.5 rounded-md">
                                <svg class="w-3 h-3 text-amber-500 fill-amber-400" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
                                @r.Rating/5
                            </span>
                        </div>
                        <p class="text-xs text-slate-600 my-2 italic leading-relaxed">
                            "@r.Comment"
                        </p>
                        <div class="text-[11px] font-medium text-slate-500 mt-3 inline-flex items-center gap-1 bg-white border border-slate-200 rounded-md px-2 py-0.5">
                            <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                            Opportunity: <span class="font-semibold text-slate-700">@r.Gig?.Title</span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

</div>
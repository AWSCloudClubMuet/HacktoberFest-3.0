@model CampusGigPortal.Models.ViewModels.GigIndexViewModel
@{
    ViewData["Title"] = "Explore Opportunities";
}

<div class="max-w-7xl mx-auto py-4 sm:py-6">

    <!-- Header Block -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 sm:mb-8">
        <div>
            <h1 class="text-2xl sm:text-4xl font-serif font-bold text-slate-900 tracking-tight flex items-center gap-2.5">
                <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-700 font-serif font-bold text-base sm:text-lg shrink-0">
                    <svg class="w-4 h-4 sm:w-5 sm:h-5 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                </div>
                Explore Opportunities
            </h1>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">
                Search verified student listings, skill exchanges, and academic requests.
            </p>
        </div>
        <a asp-controller="Gigs" asp-action="Create" class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-amber-600 hover:bg-amber-700 text-white font-semibold text-xs rounded-xl shadow-sm transition-all w-full sm:w-auto">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Post Opportunity
        </a>
    </div>

    <!-- Responsive Filter Form -->
    <div class="bg-white rounded-2xl border border-slate-200/90 p-4 sm:p-6 shadow-sm mb-6 sm:mb-8">
        <form asp-controller="Gigs" asp-action="Index" method="get" class="space-y-4">
            
            <!-- Search Keyword Bar -->
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                    <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                </div>
                <input type="text" name="q" value="@Model.Q" placeholder="Search title or keywords (Flutter, Calculus, Resume)..." 
                       class="w-full pl-10 pr-4 py-2.5 text-xs font-medium bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-amber-500 focus:outline-none transition-all" />
            </div>

            <!-- Responsive Filter Selects -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
                <div>
                    <label class="block text-[10px] sm:text-xs font-bold uppercase text-slate-500 tracking-wider mb-1">Area</label>
                    <select name="category" class="w-full text-xs font-medium bg-slate-50 border border-slate-200 rounded-lg p-2.5 focus:bg-white focus:outline-none cursor-pointer">
                        <option value="All" selected="@(string.IsNullOrEmpty(Model.Category) || Model.Category == "All")">All Areas</option>
                        <option value="Programming" selected="@(Model.Category == "Programming")">Software & Code</option>
                        <option value="Design" selected="@(Model.Category == "Design")">Design & UI/UX</option>
                        <option value="Writing" selected="@(Model.Category == "Writing")">Writing & Research</option>
                        <option value="Tutoring" selected="@(Model.Category == "Tutoring")">STEM Tutoring</option>
                    </select>
                </div>

                <div>
                    <label class="block text-[10px] sm:text-xs font-bold uppercase text-slate-500 tracking-wider mb-1">Type</label>
                    <select name="type" class="w-full text-xs font-medium bg-slate-50 border border-slate-200 rounded-lg p-2.5 focus:bg-white focus:outline-none cursor-pointer">
                        <option value="All" selected="@(string.IsNullOrEmpty(Model.Type) || Model.Type == "All")">All Types</option>
                        <option value="Offering" selected="@(Model.Type == "Offering")">Offering Service</option>
                        <option value="Requesting" selected="@(Model.Type == "Requesting")">Seeking Assistance</option>
                    </select>
                </div>

                <div>
                    <label class="block text-[10px] sm:text-xs font-bold uppercase text-slate-500 tracking-wider mb-1">Compensation</label>
                    <select name="paymentType" class="w-full text-xs font-medium bg-slate-50 border border-slate-200 rounded-lg p-2.5 focus:bg-white focus:outline-none cursor-pointer">
                        <option value="All" selected="@(string.IsNullOrEmpty(Model.PaymentType) || Model.PaymentType == "All")">All Models</option>
                        <option value="Paid" selected="@(Model.PaymentType == "Paid")">Paid Stipend</option>
                        <option value="SkillSwap" selected="@(Model.PaymentType == "SkillSwap")">Skill Exchange</option>
                        <option value="Free" selected="@(Model.PaymentType == "Free")">Volunteer</option>
                    </select>
                </div>

                <div>
                    <label class="block text-[10px] sm:text-xs font-bold uppercase text-slate-500 tracking-wider mb-1">Status</label>
                    <select name="status" class="w-full text-xs font-medium bg-slate-50 border border-slate-200 rounded-lg p-2.5 focus:bg-white focus:outline-none cursor-pointer">
                        <option value="All" selected="@(string.IsNullOrEmpty(Model.Status) || Model.Status == "All")">All Statuses</option>
                        <option value="Open" selected="@(Model.Status == "Open")">Open (Active)</option>
                        <option value="In Progress" selected="@(Model.Status == "In Progress")">In Progress</option>
                        <option value="Completed" selected="@(Model.Status == "Completed")">Completed</option>
                        <option value="Expired" selected="@(Model.Status == "Expired")">Expired</option>
                    </select>
                </div>

                <div>
                    <label class="block text-[10px] sm:text-xs font-bold uppercase text-slate-500 tracking-wider mb-1">Budget ($)</label>
                    <div class="flex items-center gap-1.5">
                        <input type="number" name="minBudget" value="@Model.MinBudget" placeholder="Min" class="w-1/2 text-xs bg-slate-50 border border-slate-200 rounded-lg p-2 focus:bg-white focus:outline-none" />
                        <span class="text-slate-400 text-xs">-</span>
                        <input type="number" name="maxBudget" value="@Model.MaxBudget" placeholder="Max" class="w-1/2 text-xs bg-slate-50 border border-slate-200 rounded-lg p-2 focus:bg-white focus:outline-none" />
                    </div>
                </div>
            </div>

            <!-- Footer Action Row -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 pt-3 border-t border-slate-100">
                <span class="text-xs font-medium text-slate-500 text-center sm:text-left">
                    Found <strong class="text-slate-900 font-bold">@Model.TotalResults</strong> opportunities
                </span>
                <div class="flex items-center justify-end gap-2">
                    <a asp-action="Index" class="px-3 py-2 text-xs font-semibold text-slate-600 hover:text-slate-900 rounded-lg hover:bg-slate-100 transition-colors">Reset</a>
                    <button type="submit" class="px-5 py-2 text-xs font-semibold text-white bg-amber-600 hover:bg-amber-700 rounded-lg transition-colors">Apply Filters</button>
                </div>
            </div>

        </form>
    </div>

    <!-- Results Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
        @foreach (var gig in Model.Gigs)
        {
            var isExpired = gig.EffectiveStatus == "Expired";
            <div class="bg-white rounded-2xl border border-slate-200/90 p-4 sm:p-5 shadow-sm hover:shadow-md transition-all flex flex-col justify-between group">
                
                <div class="pb-3">
                    <div class="flex items-center justify-between gap-2 mb-3">
                        <span class="text-[10px] sm:text-[11px] font-semibold px-2 py-0.5 sm:px-2.5 sm:py-0.5 rounded-full border @(gig.Type == "Offering" ? "bg-emerald-50 text-emerald-800 border-emerald-100" : "bg-sky-50 text-sky-800 border-sky-100")">
                            @(gig.Type == "Offering" ? "Offering Skill" : "Seeking Help")
                        </span>

                        @if (gig.PaymentType == "Paid")
                        {
                            <span class="font-bold text-xs text-emerald-800 bg-emerald-50 px-2.5 py-0.5 rounded-md border border-emerald-100">
                                $@(gig.Budget?.ToString("N0"))
                            </span>
                        }
                        else if (gig.PaymentType == "SkillSwap")
                        {
                            <span class="text-[10px] sm:text-[11px] font-semibold text-amber-800 bg-amber-50 px-2 py-0.5 sm:px-2.5 rounded-md border border-amber-100">
                                Skill Exchange
                            </span>
                        }
                        else
                        {
                            <span class="text-[10px] sm:text-[11px] font-semibold text-slate-600 bg-slate-100 px-2 py-0.5 rounded-md border border-slate-200">
                                Volunteer
                            </span>
                        }
                    </div>

                    <h3 class="font-serif font-bold text-slate-900 line-clamp-1 text-base sm:text-lg group-hover:text-amber-800 transition-colors">
                        <a asp-controller="Gigs" asp-action="Details" asp-route-id="@gig.Id">@gig.Title</a>
                    </h3>

                    <div class="flex items-center gap-2 text-[11px] font-medium text-slate-500 my-2">
                        <span>@gig.Category</span>
                        <span>&bull;</span>
                        <span class="@(isExpired ? "text-rose-600 font-bold" : "text-slate-500")">Due: @gig.Deadline.ToString("MMM dd, yyyy")</span>
                    </div>

                    <p class="text-xs text-slate-600 mt-2 line-clamp-2 leading-relaxed">@gig.Description</p>
                </div>

                <div class="pt-3 mt-auto border-t border-slate-100 flex items-center justify-between">
                    <a asp-controller="Profiles" asp-action="Index" asp-route-id="@gig.UserId" class="flex items-center gap-2">
                        <div class="w-6 h-6 sm:w-7 sm:h-7 rounded-full bg-slate-900 text-white font-bold text-xs flex items-center justify-center">
                            @(gig.User?.Name.Substring(0, 1) ?? "U")
                        </div>
                        <span class="text-xs font-medium text-slate-800 truncate max-w-[100px] sm:max-w-none">@gig.User?.Name</span>
                    </a>

                    <div class="flex items-center gap-2">
                        @if (isExpired)
                        {
                            <span class="text-[10px] font-bold text-rose-700 bg-rose-50 px-2 py-0.5 rounded border border-rose-200">Expired</span>
                        }
                        else if (gig.Status == "In Progress")
                        {
                            <span class="text-[10px] font-bold text-amber-800 bg-amber-50 px-2 py-0.5 rounded border border-amber-200">In Progress</span>
                        }
                        else if (gig.Status == "Completed")
                        {
                            <span class="text-[10px] font-bold text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">Completed</span>
                        }
                        else
                        {
                            <span class="text-[10px] font-semibold text-slate-500">Open (@gig.Applications.Count)</span>
                        }

                        <a asp-controller="Gigs" asp-action="Details" asp-route-id="@gig.Id" class="text-xs font-semibold text-amber-800 hover:text-amber-900 transition-colors">
                            Details &rarr;
                        </a>
                    </div>
                </div>

            </div>
        }
    </div>

</div>
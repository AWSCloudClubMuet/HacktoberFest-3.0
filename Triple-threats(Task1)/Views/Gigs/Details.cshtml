@model CampusGigPortal.Models.ViewModels.GigDetailViewModel
@{
    ViewData["Title"] = Model.Gig.Title;
    var gig = Model.Gig;
    var isExpired = gig.EffectiveStatus == "Expired";
    var currentUser = Model.CurrentUser;
}

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <div class="mb-6 flex items-center justify-between">
        <a asp-action="Index" class="text-xs font-semibold text-slate-500 hover:text-indigo-600">&larr; Back to Marketplace</a>
        <span class="text-xs text-slate-500">
            Viewing as <strong class="text-slate-800">@currentUser.Name</strong> 
            @(Model.IsOwner ? "(Gig Owner)" : (gig.AcceptedApplicantId == currentUser.Id ? "(Accepted Applicant)" : "(Student)"))
        </span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

        <!-- Left 2 Columns -->
        <div class="lg:col-span-2 space-y-6">
            
            <div class="bg-white rounded-3xl border border-slate-200 p-8 shadow-xs">
                
                <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
                    <div class="flex items-center gap-2">
                        <span class="px-3 py-1 rounded-full text-xs font-bold @(gig.Type == "Offering" ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-blue-50 text-blue-700 border border-blue-200")">
                            @(gig.Type == "Offering" ? "🟢 Offering Skill" : "🔵 Requesting Help")
                        </span>
                        <span class="text-xs font-semibold text-slate-600 bg-slate-100 px-3 py-1 rounded-full">@gig.Category</span>
                    </div>

                    <div>
                        @if (isExpired)
                        {
                            <span class="text-xs font-extrabold text-rose-700 bg-rose-100 px-3 py-1 rounded-full border border-rose-300">⚠️ Expired</span>
                        }
                        else if (gig.Status == "In Progress")
                        {
                            <span class="text-xs font-extrabold text-amber-700 bg-amber-100 px-3 py-1 rounded-full border border-amber-300 animate-pulse">⚡ In Progress</span>
                        }
                        else if (gig.Status == "Completed")
                        {
                            <span class="text-xs font-extrabold text-emerald-700 bg-emerald-100 px-3 py-1 rounded-full border border-emerald-300">✓ Completed</span>
                        }
                        else if (gig.Status == "Cancelled")
                        {
                            <span class="text-xs font-extrabold text-slate-600 bg-slate-200 px-3 py-1 rounded-full">✕ Cancelled</span>
                        }
                        else
                        {
                            <span class="text-xs font-extrabold text-indigo-700 bg-indigo-50 px-3 py-1 rounded-full border border-indigo-200">● Open for Applications</span>
                        }
                    </div>
                </div>

                <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 leading-tight">@gig.Title</h1>

                <div class="flex flex-wrap items-center gap-6 mt-4 pt-4 border-t border-slate-100 text-xs text-slate-500">
                    <div>Deadline: <strong class="@(isExpired ? "text-rose-600 font-bold" : "text-slate-800")">@gig.Deadline.ToString("MMM dd, yyyy")</strong></div>
                    <div>Posted: @gig.CreatedAt.ToString("MMM dd, yyyy")</div>
                    <div>@Model.Applications.Count application(s)</div>
                </div>

                <div class="mt-6">
                    <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Description & Scope</h3>
                    <div class="text-sm text-slate-700 whitespace-pre-line leading-relaxed bg-slate-50/60 p-5 rounded-2xl border border-slate-100">
                        @gig.Description
                    </div>
                </div>

                <!-- Owner Controls -->
                @if (Model.IsOwner)
                {
                    <div class="mt-8 pt-6 border-t border-slate-100 bg-slate-50/80 -mx-8 -mb-8 p-6 rounded-b-3xl flex flex-wrap items-center justify-between gap-4">
                        <div class="text-xs text-slate-600 font-medium">
                            <span class="font-bold text-indigo-700">Owner Controls:</span> 
                            @if (gig.Status == "In Progress")
                            {
                                <span>Collaborating with <strong>@gig.AcceptedApplicant?.Name</strong>.</span>
                            }
                            else if (gig.Status == "Open")
                            {
                                <span>Review applications below and accept a student to begin.</span>
                            }
                        </div>

                        <div class="flex items-center gap-3">
                            @if (gig.Status == "In Progress")
                            {
                                <form asp-action="CompleteGig" asp-route-id="@gig.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" onclick="return confirm('Mark as completed? This opens mutual reviews.')" class="px-5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl">
                                        Mark as Completed
                                    </button>
                                </form>
                            }

                            @if (gig.Status == "Open" || gig.Status == "In Progress")
                            {
                                <form asp-action="CancelGig" asp-route-id="@gig.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" onclick="return confirm('Cancel this gig?')" class="px-3.5 py-2 bg-white border border-rose-200 text-rose-600 hover:bg-rose-50 font-semibold text-xs rounded-xl">
                                        Cancel Gig
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                }

            </div>

            <!-- Owner Applicant Review (Milestone 3) -->
            @if (Model.IsOwner)
            {
                <div class="bg-white rounded-3xl border border-slate-200 p-8 shadow-xs">
                    <h2 class="text-lg font-bold text-slate-900 mb-1">Student Applicants (@Model.Applications.Count)</h2>
                    <p class="text-xs text-slate-500 mb-4">Accepting an applicant moves gig to In Progress and rejects others.</p>

                    @if (!Model.Applications.Any())
                    {
                        <div class="text-center py-8 bg-slate-50 rounded-2xl text-slate-400 text-xs">No applications yet.</div>
                    }
                    else
                    {
                        <div class="space-y-4">
                            @foreach (var app in Model.Applications)
                            {
                                var appUser = app.Applicant;
                                <div class="p-5 rounded-2xl border @(app.Status == "Accepted" ? "border-emerald-300 bg-emerald-50/40" : "border-slate-200 bg-slate-50/50") flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                                    <div class="space-y-2">
                                        <div class="flex items-center gap-3">
                                            <div class="w-8 h-8 rounded-full bg-indigo-600 text-white font-bold text-xs flex items-center justify-center">
                                                @(appUser?.Name.Substring(0, 1) ?? "U")
                                            </div>
                                            <div>
                                                <a asp-controller="Profiles" asp-action="Index" asp-route-id="@app.ApplicantId" class="text-sm font-bold text-slate-900 hover:text-indigo-600">
                                                    @appUser?.Name
                                                </a>
                                                <div class="text-[11px] text-slate-500">@appUser?.Major &bull; ★ @(appUser?.AverageRating.ToString("0.0"))</div>
                                            </div>
                                        </div>
                                        <p class="text-xs text-slate-700 bg-white p-3 rounded-xl border border-slate-200/80">"@app.Message"</p>
                                    </div>

                                    <div>
                                        @if (app.Status == "Accepted")
                                        {
                                            <span class="px-3 py-1.5 rounded-xl bg-emerald-600 text-white font-bold text-xs">✓ Accepted</span>
                                        }
                                        else if (app.Status == "Rejected")
                                        {
                                            <span class="px-3 py-1.5 rounded-xl bg-slate-200 text-slate-500 font-semibold text-xs">Rejected</span>
                                        }
                                        else if (gig.Status == "Open" && !isExpired)
                                        {
                                            <form asp-action="AcceptApplicant" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="gigId" value="@gig.Id" />
                                                <input type="hidden" name="applicationId" value="@app.Id" />
                                                <button type="submit" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl">Accept Applicant</button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            <!-- Mutual Reviews (Milestone 4) -->
            @if (gig.Status == "Completed")
            {
                <div class="bg-white rounded-3xl border border-slate-200 p-8 shadow-xs space-y-6">
                    <div>
                        <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                            <span class="text-amber-500">★</span> Mutual Reputation & Reviews
                        </h2>
                        <p class="text-xs text-slate-500">Peer reviews dynamically update student profile ratings.</p>
                    </div>

                    @if (Model.CanReview)
                    {
                        var targetUserId = Model.IsOwner ? gig.AcceptedApplicantId!.Value : gig.UserId;
                        var targetUserName = Model.IsOwner ? gig.AcceptedApplicant?.Name : gig.User?.Name;

                        <div class="bg-indigo-50/60 border border-indigo-200 rounded-2xl p-6">
                            <h3 class="font-bold text-slate-900 text-sm mb-1">Leave a Review for @targetUserName</h3>
                            <form asp-controller="Reviews" asp-action="Create" method="post" class="space-y-4 mt-3">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="GigId" value="@gig.Id" />
                                <input type="hidden" name="RevieweeId" value="@targetUserId" />

                                <div>
                                    <label class="block text-xs font-bold text-slate-700 uppercase mb-1.5">Rating (1 to 5 Stars)</label>
                                    <div class="flex items-center gap-2">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <label class="cursor-pointer">
                                                <input type="radio" name="Rating" value="@i" class="peer sr-only" checked="@(i == 5)" />
                                                <span class="px-3 py-1.5 rounded-lg border-2 border-slate-200 peer-checked:border-amber-500 peer-checked:bg-amber-100 text-xs font-bold text-slate-700">@i ★</span>
                                            </label>
                                        }
                                    </div>
                                </div>

                                <div>
                                    <label class="block text-xs font-bold text-slate-700 uppercase mb-1.5">Comment</label>
                                    <textarea name="Comment" rows="3" required placeholder="How was working with @targetUserName?" class="w-full p-3 text-xs bg-white border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500"></textarea>
                                </div>

                                <button type="submit" class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl">Submit Review</button>
                            </form>
                        </div>
                    }

                    @if (Model.Reviews.Any())
                    {
                        <div class="space-y-3 pt-2">
                            <h3 class="text-xs font-bold text-slate-400 uppercase">Reviews on this Gig</h3>
                            @foreach (var rev in Model.Reviews)
                            {
                                <div class="p-4 bg-slate-50 border border-slate-100 rounded-2xl">
                                    <div class="flex items-center justify-between mb-1.5">
                                        <span class="font-bold text-slate-800 text-xs">@rev.Reviewer?.Name &rarr; @rev.Reviewee?.Name</span>
                                        <span class="text-amber-500 text-xs font-bold">@rev.Rating/5 ★</span>
                                    </div>
                                    <p class="text-xs text-slate-600 italic">"@rev.Comment"</p>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

        </div>

        <!-- Right 1 Column -->
        <div class="space-y-6">
            
            <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-xs">
                <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Compensation</h3>
                @if (gig.PaymentType == "Paid")
                {
                    <div class="text-3xl font-extrabold text-emerald-600">$@(gig.Budget?.ToString("N0"))</div>
                    <span class="text-xs text-slate-500">Fixed Budget</span>
                }
                else if (gig.PaymentType == "SkillSwap")
                {
                    <div class="text-xl font-extrabold text-violet-700">⇄ Skill Swap</div>
                }
                else
                {
                    <div class="text-xl font-extrabold text-slate-800">🎁 Free / Volunteer</div>
                }
            </div>

            <!-- Author Card -->
            <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-xs">
                <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">Posted By</h3>
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-10 h-10 rounded-xl bg-indigo-600 text-white font-bold flex items-center justify-center">
                        @(gig.User?.Name.Substring(0, 1) ?? "U")
                    </div>
                    <div>
                        <a asp-controller="Profiles" asp-action="Index" asp-route-id="@gig.UserId" class="font-bold text-slate-900 text-sm hover:text-indigo-600 block">@gig.User?.Name</a>
                        <div class="text-xs text-slate-500">@gig.User?.Major</div>
                    </div>
                </div>
                <div class="flex items-center justify-between p-3 bg-slate-50 rounded-xl text-xs">
                    <div>
                        <span class="text-slate-400 block text-[10px]">Campus Rating</span>
                        <span class="font-bold text-amber-500">★ @(gig.User?.AverageRating.ToString("0.0"))</span>
                    </div>
                    <div>
                        <span class="text-slate-400 block text-[10px]">Completed</span>
                        <span class="font-bold text-slate-800">@gig.User?.CompletedGigsCount</span>
                    </div>
                </div>
            </div>

            <!-- Application Box (Non-Owner) -->
            @if (!Model.IsOwner)
            {
                <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-xs">
                    <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">Your Application</h3>

                    @if (Model.HasApplied)
                    {
                        <div class="p-4 rounded-2xl bg-indigo-50 border border-indigo-200 text-indigo-800 text-xs">
                            <span class="font-bold uppercase">Status: @Model.UserApplication?.Status</span>
                            <p class="mt-1 italic">"@Model.UserApplication?.Message"</p>
                        </div>
                    }
                    else if (isExpired)
                    {
                        <div class="p-3 bg-rose-50 border border-rose-200 text-rose-700 text-xs rounded-xl">Gig is expired.</div>
                    }
                    else if (gig.Status != "Open")
                    {
                        <div class="p-3 bg-slate-100 text-slate-600 text-xs rounded-xl">Gig is @gig.Status.</div>
                    }
                    else
                    {
                        <form asp-action="Apply" method="post" class="space-y-4">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="gigId" value="@gig.Id" />
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 mb-1">Pitch Message</label>
                                <textarea name="message" rows="4" required placeholder="Why are you a great fit?" class="w-full p-3 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-indigo-500"></textarea>
                            </div>
                            <button type="submit" class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl">Submit Application</button>
                        </form>
                    }
                </div>
            }

        </div>

    </div>

</div>
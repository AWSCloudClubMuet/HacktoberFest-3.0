@model CampusGigPortal.Models.ViewModels.GigCreateViewModel
@{
    ViewData["Title"] = "Post a Campus Opportunity";
}

<div class="max-w-3xl mx-auto py-8">

    <!-- Header Block -->
    <div class="mb-8">
        <a asp-action="Index" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-amber-800 transition-colors mb-3">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            Back to Opportunities
        </a>
        <h1 class="text-3xl sm:text-4xl font-serif font-bold text-slate-900 tracking-tight">
            Post a Campus Opportunity
        </h1>
        <p class="text-sm text-slate-500 mt-1.5 leading-relaxed">
            Offer a skill or request academic collaboration from fellow scholars across campus.
        </p>
    </div>

    <!-- Main Card Container -->
    <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-6 sm:p-10">
        <form asp-action="Create" method="post" class="space-y-6">
            @Html.AntiForgeryToken()

            <!-- Validation Summary -->
            <div asp-validation-summary="ModelOnly" class="p-4 bg-rose-50 border border-rose-200 text-rose-900 text-xs rounded-xl font-medium"></div>

            <!-- Role / Intent Selector -->
            <div>
                <label class="block text-xs font-bold uppercase text-slate-500 tracking-wider mb-2.5">
                    Engagement Type
                </label>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <label class="cursor-pointer">
                        <input type="radio" name="Type" value="Requesting" class="peer sr-only" checked="@(Model.Type == "Requesting")" />
                        <div class="p-4 rounded-xl border-2 border-slate-200 bg-slate-50/50 peer-checked:border-amber-600 peer-checked:bg-amber-50/40 transition-all text-left">
                            <span class="block text-sm font-serif font-bold text-slate-900">Seeking Assistance</span>
                            <span class="block text-xs text-slate-500 mt-1">Request tutoring, design, or project help</span>
                        </div>
                    </label>

                    <label class="cursor-pointer">
                        <input type="radio" name="Type" value="Offering" class="peer sr-only" checked="@(Model.Type == "Offering")" />
                        <div class="p-4 rounded-xl border-2 border-slate-200 bg-slate-50/50 peer-checked:border-emerald-700 peer-checked:bg-emerald-50/40 transition-all text-left">
                            <span class="block text-sm font-serif font-bold text-slate-900">Offering a Service</span>
                            <span class="block text-xs text-slate-500 mt-1">Provide coding, editing, or mentoring</span>
                        </div>
                    </label>
                </div>
            </div>

            <!-- Gig Title Input -->
            <div>
                <label asp-for="Title" class="block text-xs font-bold uppercase text-slate-500 tracking-wider mb-1.5">
                    Opportunity Title
                </label>
                <input asp-for="Title" placeholder="e.g., Build a React + Node.js Student Club Portal" class="w-full px-4 py-2.5 text-xs font-medium bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-amber-500 focus:border-amber-500 focus:outline-none transition-all" />
                <span asp-validation-for="Title" class="text-rose-600 text-xs mt-1 block font-medium"></span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <!-- Category Select -->
                <div>
                    <label asp-for="Category" class="block text-xs font-bold uppercase text-slate-500 tracking-wider mb-1.5">
                        Academic Area
                    </label>
                    <select asp-for="Category" class="w-full px-3.5 py-2.5 text-xs font-medium bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-amber-500 focus:outline-none cursor-pointer transition-all">
                        <option value="Programming">💻 Programming & Web/Mobile</option>
                        <option value="Design">🎨 Graphic & UI/UX Design</option>
                        <option value="Writing">✍️ Writing & Editing</option>
                        <option value="Tutoring">📚 STEM & Subject Tutoring</option>
                    </select>
                    <span asp-validation-for="Category" class="text-rose-600 text-xs mt-1 block font-medium"></span>
                </div>

                <!-- Deadline Picker -->
                <div>
                    <label asp-for="Deadline" class="block text-xs font-bold uppercase text-slate-500 tracking-wider mb-1.5">
                        Target Completion Date
                    </label>
                    <input asp-for="Deadline" type="date" class="w-full px-3.5 py-2.5 text-xs font-medium bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-amber-500 focus:outline-none transition-all" />
                    <span asp-validation-for="Deadline" class="text-rose-600 text-xs mt-1 block font-medium"></span>
                </div>
            </div>

            <!-- Compensation Radios -->
            <div>
                <label class="block text-xs font-bold uppercase text-slate-500 tracking-wider mb-2.5">
                    Compensation Model
                </label>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <label class="cursor-pointer">
                        <input type="radio" name="PaymentType" value="Paid" id="payPaid" class="peer sr-only" checked="@(Model.PaymentType == "Paid")" onchange="toggleBudgetInput(true)" />
                        <div class="p-3 text-center border-2 border-slate-200 bg-slate-50/50 rounded-xl peer-checked:border-emerald-700 peer-checked:bg-emerald-50/50 text-xs font-bold text-slate-800 transition-all">
                            💵 Paid Stipend ($)
                        </div>
                    </label>

                    <label class="cursor-pointer">
                        <input type="radio" name="PaymentType" value="SkillSwap" id="paySwap" class="peer sr-only" checked="@(Model.PaymentType == "SkillSwap")" onchange="toggleBudgetInput(false)" />
                        <div class="p-3 text-center border-2 border-slate-200 bg-slate-50/50 rounded-xl peer-checked:border-amber-600 peer-checked:bg-amber-50/50 text-xs font-bold text-slate-800 transition-all">
                            ⇄ Skill Exchange
                        </div>
                    </label>

                    <label class="cursor-pointer">
                        <input type="radio" name="PaymentType" value="Free" id="payFree" class="peer sr-only" checked="@(Model.PaymentType == "Free")" onchange="toggleBudgetInput(false)" />
                        <div class="p-3 text-center border-2 border-slate-200 bg-slate-50/50 rounded-xl peer-checked:border-slate-800 peer-checked:bg-slate-100 text-xs font-bold text-slate-800 transition-all">
                            🎁 Peer Volunteer
                        </div>
                    </label>
                </div>
            </div>

            <!-- Dynamic Budget Input -->
            <div id="budgetWrapper" class="@(Model.PaymentType == "Paid" ? "" : "hidden")">
                <label asp-for="Budget" class="block text-xs font-bold uppercase text-slate-500 tracking-wider mb-1.5">
                    Stipend Amount (USD $)
                </label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400 font-bold text-xs">$</span>
                    <input asp-for="Budget" type="number" step="0.01" placeholder="50.00" class="w-full pl-8 pr-4 py-2.5 text-xs font-medium bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-amber-500 focus:outline-none transition-all" />
                </div>
                <span asp-validation-for="Budget" class="text-rose-600 text-xs mt-1 block font-medium"></span>
            </div>

            <!-- Description Textarea -->
            <div>
                <label asp-for="Description" class="block text-xs font-bold uppercase text-slate-500 tracking-wider mb-1.5">
                    Description & Deliverables
                </label>
                <textarea asp-for="Description" rows="5" placeholder="Specify project scope, required prerequisites, tools, meeting frequency..." class="w-full p-3.5 text-xs font-medium bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-amber-500 focus:outline-none transition-all"></textarea>
                <span asp-validation-for="Description" class="text-rose-600 text-xs mt-1 block font-medium"></span>
            </div>

            <!-- Action Buttons -->
            <div class="pt-6 border-t border-slate-100 flex items-center justify-end gap-3">
                <a asp-action="Index" class="px-5 py-2.5 text-xs font-semibold text-slate-600 hover:text-slate-900 rounded-xl transition-colors">
                    Cancel
                </a>
                <button type="submit" class="px-6 py-2.5 text-xs font-semibold text-white bg-amber-600 hover:bg-amber-700 rounded-xl shadow-sm transition-all">
                    Publish Opportunity
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function toggleBudgetInput(show) {
            const wrapper = document.getElementById('budgetWrapper');
            if (show) {
                wrapper.classList.remove('hidden');
            } else {
                wrapper.classList.add('hidden');
            }
        }
    </script>
}
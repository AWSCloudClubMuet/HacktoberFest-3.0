@model CampusGigPortal.Models.ViewModels.GigCreateViewModel
@{
    ViewData["Title"] = "Post a Campus Gig";
}

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <div class="mb-8">
        <a asp-action="Index" class="text-xs font-semibold text-slate-500 hover:text-indigo-600">&larr; Back to Gigs</a>
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight mt-1">Create a Campus Gig</h1>
        <p class="text-sm text-slate-500">Post a service you can offer or request help from campus peers.</p>
    </div>

    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-8">
        <form asp-action="Create" method="post" class="space-y-6">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="p-3 bg-rose-50 border border-rose-200 text-rose-700 text-xs rounded-xl"></div>

            <!-- Role / Intent Selector -->
            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Gig Intent</label>
                <div class="grid grid-cols-2 gap-4">
                    <label class="cursor-pointer">
                        <input type="radio" name="Type" value="Requesting" class="peer sr-only" checked="@(Model.Type == " Requesting")" />
                        <div class="p-4 rounded-2xl border-2 border-slate-200 peer-checked:border-indigo-600 peer-checked:bg-indigo-50/50 text-center">
                            <span class="block text-sm font-bold text-slate-800">I Need Help</span>
                            <span class="block text-[11px] text-slate-500">Request service or tutoring</span>
                        </div>
                    </label>

                    <label class="cursor-pointer">
                        <input type="radio" name="Type" value="Offering" class="peer sr-only" checked="@(Model.Type == " Offering")" />
                        <div class="p-4 rounded-2xl border-2 border-slate-200 peer-checked:border-emerald-600 peer-checked:bg-emerald-50/50 text-center">
                            <span class="block text-sm font-bold text-slate-800">I Am Offering a Skill</span>
                            <span class="block text-[11px] text-slate-500">Offer coding, design, editing</span>
                        </div>
                    </label>
                </div>
            </div>

            <div>
                <label asp-for="Title" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Gig Title</label>
                <input asp-for="Title" placeholder="e.g., Build a React + Node.js Student Club Portal" class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                <span asp-validation-for="Title" class="text-rose-500 text-xs mt-1 block"></span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="Category" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Category</label>
                    <select asp-for="Category" class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-indigo-500">
                        <option value="Programming">💻 Programming & Web/Mobile</option>
                        <option value="Design">🎨 Graphic & UI/UX Design</option>
                        <option value="Writing">✍️ Writing & Editing</option>
                        <option value="Tutoring">📚 STEM & Subject Tutoring</option>
                    </select>
                    <span asp-validation-for="Category" class="text-rose-500 text-xs mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="Deadline" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Target Deadline</label>
                    <input asp-for="Deadline" type="date" class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-indigo-500" />
                    <span asp-validation-for="Deadline" class="text-rose-500 text-xs mt-1 block"></span>
                </div>
            </div>

            <!-- Compensation Radios -->
            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Compensation Type</label>
                <div class="grid grid-cols-3 gap-3">
                    <label class="cursor-pointer">
                        <input type="radio" name="PaymentType" value="Paid" id="payPaid" class="peer sr-only" checked="@(Model.PaymentType == " Paid")" onchange="toggleBudgetInput(true)" />
                        <div class="p-3 text-center border-2 border-slate-200 rounded-xl peer-checked:border-emerald-600 peer-checked:bg-emerald-50 text-xs font-bold text-slate-800">
                            💵 Paid ($)
                        </div>
                    </label>

                    <label class="cursor-pointer">
                        <input type="radio" name="PaymentType" value="SkillSwap" id="paySwap" class="peer sr-only" checked="@(Model.PaymentType == " SkillSwap")" onchange="toggleBudgetInput(false)" />
                        <div class="p-3 text-center border-2 border-slate-200 rounded-xl peer-checked:border-violet-600 peer-checked:bg-violet-50 text-xs font-bold text-slate-800">
                            ⇄ Skill Swap
                        </div>
                    </label>

                    <label class="cursor-pointer">
                        <input type="radio" name="PaymentType" value="Free" id="payFree" class="peer sr-only" checked="@(Model.PaymentType == " Free")" onchange="toggleBudgetInput(false)" />
                        <div class="p-3 text-center border-2 border-slate-200 rounded-xl peer-checked:border-slate-800 peer-checked:bg-slate-100 text-xs font-bold text-slate-800">
                            🎁 Free
                        </div>
                    </label>
                </div>
            </div>

            <!-- Dynamic Budget Input for Paid Gigs -->
            <div id="budgetWrapper" class="@(Model.PaymentType == " Paid" ? "" : "hidden" )">
                <label asp-for="Budget" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Estimated Budget (USD $)</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400 font-bold">$</span>
                    <input asp-for="Budget" type="number" step="0.01" placeholder="50.00" class="w-full pl-8 pr-4 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-indigo-500" />
                </div>
                <span asp-validation-for="Budget" class="text-rose-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Description" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Description & Scope</label>
                <textarea asp-for="Description" rows="5" placeholder="Specify deliverables, required tools, meeting cadence, etc..." class="w-full p-3.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-indigo-500"></textarea>
                <span asp-validation-for="Description" class="text-rose-500 text-xs mt-1 block"></span>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-3">
                <a asp-action="Index" class="px-5 py-2.5 text-xs font-semibold text-slate-600 hover:text-slate-900 rounded-xl">Cancel</a>
                <button type="submit" class="px-7 py-2.5 text-xs font-bold text-white bg-indigo-600 hover:bg-indigo-700 rounded-xl shadow-md">Publish Gig</button>
            </div>
        </form>
    </div>

</div>

@section Scripts {
<script>
        function toggleBudgetInput(show) {
            const wrapper = document.getElementById('budgetWrapper');
            if (show) wrapper.classList.remove('hidden');
            else wrapper.classList.add('hidden');
        }
</script>
}
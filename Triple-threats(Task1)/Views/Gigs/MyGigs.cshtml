@model CampusGigPortal.Models.ViewModels.MyGigsViewModel
@{
    ViewData["Title"] = "My Gigs & Applications";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <div class="mb-8 flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">My Gigs & Applications</h1>
            <p class="text-sm text-slate-500">Track your posted gigs and submitted applications.</p>
        </div>
        <a asp-action="Create" class="px-4 py-2 bg-indigo-600 text-white text-xs font-bold rounded-xl">+ Post Gig</a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        
        <!-- Posted Gigs -->
        <div class="space-y-4">
            <h2 class="text-lg font-bold text-slate-900">Gigs I've Posted (@Model.PostedGigs.Count)</h2>
            @foreach (var gig in Model.PostedGigs)
            {
                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-2xs">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xs font-semibold px-2 py-0.5 rounded bg-slate-100 text-slate-600">@gig.Category</span>
                        <span class="text-[11px] font-bold px-2 py-0.5 rounded bg-indigo-50 text-indigo-700">@gig.EffectiveStatus</span>
                    </div>
                    <h3 class="font-bold text-slate-900 text-sm hover:text-indigo-600">
                        <a asp-action="Details" asp-route-id="@gig.Id">@gig.Title</a>
                    </h3>
                    <div class="flex items-center justify-between mt-3 text-xs text-slate-500">
                        <span>@gig.Applications.Count applicant(s)</span>
                        <a asp-action="Details" asp-route-id="@gig.Id" class="text-indigo-600 font-bold">Manage &rarr;</a>
                    </div>
                </div>
            }
        </div>

        <!-- Submitted Applications -->
        <div class="space-y-4">
            <h2 class="text-lg font-bold text-slate-900">My Submitted Applications (@Model.MyApplications.Count)</h2>
            @foreach (var app in Model.MyApplications)
            {
                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-2xs">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xs font-semibold text-slate-500">Posted by @app.Gig?.User?.Name</span>
                        <span class="text-[11px] font-bold px-2 py-0.5 rounded @(app.Status == "Accepted" ? "bg-emerald-100 text-emerald-800" : app.Status == "Rejected" ? "bg-slate-100 text-slate-500" : "bg-amber-100 text-amber-800")">
                            @app.Status
                        </span>
                    </div>
                    <h3 class="font-bold text-slate-900 text-sm hover:text-indigo-600">
                        <a asp-action="Details" asp-route-id="@app.GigId">@app.Gig?.Title</a>
                    </h3>
                    <p class="text-xs text-slate-600 mt-2 italic bg-slate-50 p-2.5 rounded-lg">"@app.Message"</p>
                </div>
            }
        </div>

    </div>

</div>
@model CampusGigPortal.Models.ViewModels.MyGigsViewModel
@{
    ViewData["Title"] = "My Engagements & Applications";
}

<div class="max-w-7xl mx-auto py-4 sm:py-6">

    <!-- Header Block -->
    <div class="mb-6 sm:mb-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-slate-200/80 pb-4 sm:pb-6">
        <div>
            <h1 class="text-2xl sm:text-4xl font-serif font-bold text-slate-900 tracking-tight flex items-center gap-2.5">
                <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-700 font-serif font-bold text-base sm:text-lg shrink-0">
                    <svg class="w-4 h-4 sm:w-5 sm:h-5 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                    </svg>
                </div>
                My Engagements & Applications
            </h1>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">
                Manage academic opportunities you posted and monitor submitted peer applications.
            </p>
        </div>

        <a asp-action="Create" class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-amber-600 hover:bg-amber-700 text-white font-semibold text-xs rounded-xl shadow-sm transition-all w-full sm:w-auto">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Post Opportunity
        </a>
    </div>

    <!-- 2 Column Layout: Posted vs Applied -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8">

        <!-- Column 1: Opportunities Posted by Current User -->
        <div class="space-y-4">
            <div class="flex items-center justify-between bg-slate-900 text-white p-3.5 sm:p-4 rounded-xl shadow-sm">
                <h2 class="text-xs sm:text-sm font-serif font-bold text-amber-100 tracking-wide flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                    Opportunities Posted (@Model.PostedGigs.Count)
                </h2>
                <span class="text-[10px] font-mono text-slate-400">Creator Log</span>
            </div>

            @if (!Model.PostedGigs.Any())
            {
                <div class="p-6 sm:p-8 bg-white rounded-2xl border border-slate-200/90 text-center text-xs font-medium text-slate-500 border-dashed">
                    You haven't posted any campus opportunities yet.
                    <a asp-action="Create" class="block text-amber-700 font-bold mt-2 hover:underline">Post your first opportunity &rarr;</a>
                </div>
            }
            else
            {
                <div class="space-y-3">
                    @foreach (var gig in Model.PostedGigs)
                    {
                        var isExpired = gig.EffectiveStatus == "Expired";
                        <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/90 shadow-sm hover:shadow-md transition-all">
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-[10px] sm:text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700">
                                    @gig.Category
                                </span>
                                <div>
                                    @if (isExpired)
                                    {
                                        <span class="text-[10px] sm:text-[11px] font-bold text-rose-700 bg-rose-50 px-2.5 py-0.5 rounded-md border border-rose-200">Expired</span>
                                    }
                                    else if (gig.Status == "In Progress")
                                    {
                                        <span class="text-[10px] sm:text-[11px] font-bold text-amber-800 bg-amber-50 px-2.5 py-0.5 rounded-md border border-amber-200">In Progress</span>
                                    }
                                    else if (gig.Status == "Completed")
                                    {
                                        <span class="text-[10px] sm:text-[11px] font-bold text-emerald-800 bg-emerald-50 px-2.5 py-0.5 rounded-md border border-emerald-200">Completed</span>
                                    }
                                    else
                                    {
                                        <span class="text-[10px] sm:text-[11px] font-bold text-slate-800 bg-slate-100 px-2.5 py-0.5 rounded-md border border-slate-200">Open</span>
                                    }
                                </div>
                            </div>

                            <h3 class="font-serif font-bold text-slate-900 text-base sm:text-lg hover:text-amber-800 transition-colors">
                                <a asp-action="Details" asp-route-id="@gig.Id">@gig.Title</a>
                            </h3>

                            <div class="flex items-center justify-between mt-4 pt-3 border-t border-slate-100 text-xs text-slate-500">
                                <div class="truncate max-w-[200px] sm:max-w-none">
                                    <span class="font-bold text-slate-900">@gig.Applications.Count</span> applicant(s)
                                    @if (gig.AcceptedApplicant != null)
                                    {
                                        <span class="text-slate-400 ml-1">&bull; Assigned: <strong>@gig.AcceptedApplicant.Name</strong></span>
                                    }
                                </div>

                                <a asp-action="Details" asp-route-id="@gig.Id" class="font-semibold text-amber-800 hover:text-amber-900 transition-colors shrink-0">
                                    Manage &rarr;
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Column 2: Applications Submitted by Current User -->
        <div class="space-y-4">
            <div class="flex items-center justify-between bg-slate-900 text-white p-3.5 sm:p-4 rounded-xl shadow-sm">
                <h2 class="text-xs sm:text-sm font-serif font-bold text-amber-100 tracking-wide flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                    Submitted Applications (@Model.MyApplications.Count)
                </h2>
                <span class="text-[10px] font-mono text-slate-400">Applicant Log</span>
            </div>

            @if (!Model.MyApplications.Any())
            {
                <div class="p-6 sm:p-8 bg-white rounded-2xl border border-slate-200/90 text-center text-xs font-medium text-slate-500 border-dashed">
                    You haven't applied to any opportunities yet.
                    <a asp-action="Index" class="block text-amber-700 font-bold mt-2 hover:underline">Browse opportunities now &rarr;</a>
                </div>
            }
            else
            {
                <div class="space-y-3">
                    @foreach (var app in Model.MyApplications)
                    {
                        var gig = app.Gig;
                        <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/90 shadow-sm hover:shadow-md transition-all">
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-[10px] sm:text-[11px] font-medium text-slate-500">
                                    Posted by <strong class="text-slate-800 font-semibold">@gig?.User?.Name</strong>
                                </span>
                                <div>
                                    @if (app.Status == "Accepted")
                                    {
                                        <span class="inline-flex items-center gap-1 text-[10px] sm:text-[11px] font-bold text-emerald-800 bg-emerald-50 px-2.5 py-0.5 rounded-md border border-emerald-200">
                                            <svg class="w-3 h-3 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                            Accepted
                                        </span>
                                    }
                                    else if (app.Status == "Rejected")
                                    {
                                        <span class="inline-flex items-center gap-1 text-[10px] sm:text-[11px] font-bold text-rose-800 bg-rose-50 px-2.5 py-0.5 rounded-md border border-rose-200">
                                            <svg class="w-3 h-3 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                                            Rejected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 text-[10px] sm:text-[11px] font-bold text-amber-800 bg-amber-50 px-2.5 py-0.5 rounded-md border border-amber-200">
                                            <svg class="w-3 h-3 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                            Pending Review
                                        </span>
                                    }
                                </div>
                            </div>

                            <h3 class="font-serif font-bold text-slate-900 text-base sm:text-lg hover:text-amber-800 transition-colors">
                                <a asp-action="Details" asp-route-id="@app.GigId">@gig?.Title</a>
                            </h3>

                            <div class="mt-3 bg-slate-50 border border-slate-200/60 rounded-xl p-3 text-xs text-slate-600 italic line-clamp-2">
                                "@app.Message"
                            </div>

                            <div class="flex items-center justify-between mt-3 text-[11px] text-slate-400">
                                <span>Applied: @app.CreatedAt.ToString("MMM dd, yyyy")</span>
                                <a asp-action="Details" asp-route-id="@app.GigId" class="font-semibold text-amber-800 hover:text-amber-900 transition-colors">
                                    View Opportunity &rarr;
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</div>
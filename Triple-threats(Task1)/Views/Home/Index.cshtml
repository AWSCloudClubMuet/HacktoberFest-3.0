@model CampusGigPortal.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Academic Dashboard";
}

<!-- Hero Banner -->
<div class="bg-[#0F172A] text-white rounded-2xl p-8 sm:p-12 shadow-sm mb-10 border border-slate-800 relative overflow-hidden">
    <div class="max-w-3xl">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 text-xs font-semibold mb-4 border border-amber-500/30">
            <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            Verified Academic Peer Network
        </span>
        <h1 class="text-3xl sm:text-5xl font-serif font-bold text-amber-50 leading-tight">
            Exchange Knowledge, Offer Skills, & Collaborate.
        </h1>
        <p class="mt-4 text-slate-300 text-sm sm:text-base leading-relaxed">
            Connect with campus peers for software development, research editing, graphic design, and course tutoring.
        </p>

        <!-- Search Form -->
        <form asp-controller="Gigs" asp-action="Index" method="get" class="mt-8 flex flex-col sm:flex-row items-center gap-2 max-w-lg">
            <div class="relative w-full">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                </div>
                <input type="text" name="q" placeholder="Search skills, courses, or services..." class="w-full pl-10 pr-4 py-2.5 bg-slate-800/90 text-white placeholder-slate-400 rounded-xl border border-slate-700 text-xs focus:outline-none focus:ring-2 focus:ring-amber-500" />
            </div>
            <button type="submit" class="w-full sm:w-auto px-5 py-2.5 bg-amber-600 hover:bg-amber-700 font-semibold rounded-xl text-xs text-white shadow-sm transition-all whitespace-nowrap">
                Search Network
            </button>
        </form>
    </div>
</div>

<!-- Category Cards Grid -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-10">
    <!-- Programming -->
    <a asp-controller="Gigs" asp-action="Index" asp-route-category="Programming" class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md hover:border-slate-300 transition-all flex flex-col justify-between group">
        <div>
            <span class="text-xs font-bold text-amber-700 bg-amber-50 px-2 py-1 rounded-md border border-amber-100 float-right">
                @(Model.CategoryCounts.GetValueOrDefault("Programming", 0)) Active
            </span>
            <div class="w-10 h-10 rounded-xl bg-slate-900 text-amber-400 flex items-center justify-center font-serif font-bold text-lg mb-3">
                <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
            </div>
            <h3 class="font-serif font-bold text-slate-900 text-lg group-hover:text-amber-700 transition-colors">Software & Code</h3>
            <p class="text-xs text-slate-500 mt-1">C#, Python, Web Dev, Algorithms</p>
        </div>
    </a>

    <!-- Design -->
    <a asp-controller="Gigs" asp-action="Index" asp-route-category="Design" class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md hover:border-slate-300 transition-all flex flex-col justify-between group">
        <div>
            <span class="text-xs font-bold text-amber-700 bg-amber-50 px-2 py-1 rounded-md border border-amber-100 float-right">
                @(Model.CategoryCounts.GetValueOrDefault("Design", 0)) Active
            </span>
            <div class="w-10 h-10 rounded-xl bg-slate-900 text-amber-400 flex items-center justify-center font-serif font-bold text-lg mb-3">
                <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>
            </div>
            <h3 class="font-serif font-bold text-slate-900 text-lg group-hover:text-amber-700 transition-colors">UI/UX & Design</h3>
            <p class="text-xs text-slate-500 mt-1">Figma, Logos, Diagrams, Media</p>
        </div>
    </a>

    <!-- Writing -->
    <a asp-controller="Gigs" asp-action="Index" asp-route-category="Writing" class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md hover:border-slate-300 transition-all flex flex-col justify-between group">
        <div>
            <span class="text-xs font-bold text-amber-700 bg-amber-50 px-2 py-1 rounded-md border border-amber-100 float-right">
                @(Model.CategoryCounts.GetValueOrDefault("Writing", 0)) Active
            </span>
            <div class="w-10 h-10 rounded-xl bg-slate-900 text-amber-400 flex items-center justify-center font-serif font-bold text-lg mb-3">
                <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
            </div>
            <h3 class="font-serif font-bold text-slate-900 text-lg group-hover:text-amber-700 transition-colors">Writing & Papers</h3>
            <p class="text-xs text-slate-500 mt-1">LaTeX, SOPs, Essay Editing</p>
        </div>
    </a>

    <!-- Tutoring -->
    <a asp-controller="Gigs" asp-action="Index" asp-route-category="Tutoring" class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md hover:border-slate-300 transition-all flex flex-col justify-between group">
        <div>
            <span class="text-xs font-bold text-amber-700 bg-amber-50 px-2 py-1 rounded-md border border-amber-100 float-right">
                @(Model.CategoryCounts.GetValueOrDefault("Tutoring", 0)) Active
            </span>
            <div class="w-10 h-10 rounded-xl bg-slate-900 text-amber-400 flex items-center justify-center font-serif font-bold text-lg mb-3">
                <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
            </div>
            <h3 class="font-serif font-bold text-slate-900 text-lg group-hover:text-amber-700 transition-colors">STEM Tutoring</h3>
            <p class="text-xs text-slate-500 mt-1">Calculus, Physics, Statistics</p>
        </div>
    </a>
</div>

<!-- Recent Opportunities -->
<div>
    <div class="flex items-center justify-between mb-6">
        <div>
            <h2 class="text-2xl font-serif font-bold text-slate-900">Recent Campus Postings</h2>
            <p class="text-xs text-slate-500 mt-0.5">Explore active listings from scholars across all faculties</p>
        </div>
        <a asp-controller="Gigs" asp-action="Index" class="text-xs font-semibold text-amber-700 hover:text-amber-900">
            View All Gigs &rarr;
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var gig in Model.RecentGigs)
        {
            <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between gap-2 mb-3">
                        <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700">
                            @gig.Type
                        </span>
                        <span class="text-xs font-bold text-emerald-800 bg-emerald-50 px-2.5 py-0.5 rounded-md border border-emerald-100">
                            @(gig.PaymentType == "Paid" ? $"${gig.Budget?.ToString("N0")}" : gig.PaymentType)
                        </span>
                    </div>

                    <h3 class="font-serif font-bold text-slate-900 text-base line-clamp-1 hover:text-amber-700 transition-colors">
                        <a asp-controller="Gigs" asp-action="Details" asp-route-id="@gig.Id">@gig.Title</a>
                    </h3>

                    <p class="text-xs text-slate-600 mt-2 line-clamp-2 leading-relaxed">
                        @gig.Description
                    </p>
                </div>

                <div class="pt-4 mt-4 border-t border-slate-100 flex items-center justify-between">
                    <a asp-controller="Profiles" asp-action="Index" asp-route-id="@gig.UserId" class="flex items-center gap-2">
                        <div class="w-7 h-7 rounded-full bg-slate-900 text-white font-bold text-xs flex items-center justify-center">
                            @(gig.User?.Name.Substring(0, 1) ?? "U")
                        </div>
                        <span class="text-xs font-medium text-slate-700">@gig.User?.Name</span>
                    </a>
                    <a asp-controller="Gigs" asp-action="Details" asp-route-id="@gig.Id" class="text-xs font-semibold text-amber-700 hover:underline">
                        Details &rarr;
                    </a>
                </div>
            </div>
        }
    </div>
</div>
{
  "name": "saawak-backend",
  "version": "1.0.0",
  "description": "saa-wak (ساوڪ) — Backend API server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"ts-node -r dotenv/config src/index.ts\"",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "ts-node -r dotenv/config prisma/seed.ts",
    "test": "node --test dist/tests/*.test.js"
  },
  "prisma": {
    "seed": "ts-node -r dotenv/config prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@prisma/client": "6.4.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "socket.io": "^4.8.4",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.14",
    "prisma": "6.4.1",
    "ts-node": "^10.9.2",
    "typescript": "5.7.3"
  },
  "keywords": [
    "saawak",
    "sindh",
    "agriculture",
    "mandi"
  ],
  "author": "",
  "license": "ISC"
}

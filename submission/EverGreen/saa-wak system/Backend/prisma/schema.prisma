// ============================================================
// saa-wak (ساوڪ) — Prisma Database Schema
// PostgreSQL — all six domain entities + conversations/messages
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── USERS ────────────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String
  passwordHash String
  role         UserRole
  district     String
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  listings              Listing[]      @relation("UserListings")
  alerts                Alert[]
  sentMessages          Message[]      @relation("SentMessages")
  conversationsAsUser1  Conversation[] @relation("ConversationUser1")
  conversationsAsUser2  Conversation[] @relation("ConversationUser2")

  @@index([email])
  @@index([role])
}

enum UserRole {
  farmer
  buyer
}

// ── CROPS ────────────────────────────────────────────────────
model Crop {
  id          String       @id
  name        String
  sindhiName  String?
  category    CropCategory
  unit        String
  symbol      String       @default("🌱")
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())

  prices   Price[]
  listings Listing[]
  alerts   Alert[]

  @@index([category])
  @@index([isActive])
}

enum CropCategory {
  Grains
  CashCrops
  Vegetables
  Fruits
  Spices
}

// ── MARKETS ─────────────────────────────────────────────────
model Market {
  id               String   @id
  name             String
  sindhiName       String?
  district         String
  province         String   @default("Sindh")
  isActive         Boolean  @default(true)
  distanceKmApprox Int?
  createdAt        DateTime @default(now())

  prices        Price[]
  listings      Listing[]
  alerts        Alert[]
  conversations Conversation[]

  @@index([district])
  @@index([isActive])
}

// ── PRICES ─────────────────────────────────────────────────
model Price {
  id          String   @id
  cropId      String
  marketId    String
  date        DateTime @db.Date
  price       Decimal  @db.Decimal(12, 2)
  unit        String
  sourceLabel String   @default("Fictional demo data — Sindh Agri Mandi simulation")
  createdAt   DateTime @default(now())

  crop   Crop   @relation(fields: [cropId], references: [id], onDelete: Cascade)
  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([cropId, marketId, date])
  @@index([cropId])
  @@index([marketId])
  @@index([date])
  @@index([cropId, marketId])
}

// ── LISTINGS ────────────────────────────────────────────────
model Listing {
  id                 String        @id @default(cuid())
  sellerId           String
  cropId             String
  marketId           String
  quantity           Decimal       @db.Decimal(12, 2)
  unit               String
  grade              ListingGrade
  askingPricePerUnit Decimal       @db.Decimal(12, 2)
  district           String
  description        String?
  contactMethod      String?
  status             ListingStatus @default(available)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  seller User   @relation("UserListings", fields: [sellerId], references: [id])
  crop   Crop   @relation(fields: [cropId], references: [id])
  market Market @relation(fields: [marketId], references: [id])

  conversations Conversation[]

  @@index([sellerId])
  @@index([cropId])
  @@index([marketId])
  @@index([status])
  @@index([district])
  @@index([createdAt])
}

enum ListingGrade {
  GradeA
  GradeB
  ExportQuality
  Standard
}

enum ListingStatus {
  available
  reserved
  sold
}

// ── ALERTS ─────────────────────────────────────────────────
model Alert {
  id                 String         @id @default(cuid())
  userId             String
  cropId             String
  marketId           String
  condition          AlertCondition
  targetPrice        Decimal        @db.Decimal(12, 2)
  isEnabled          Boolean        @default(true)
  lastEvaluatedPrice Decimal?       @db.Decimal(12, 2)
  lastTriggeredAt    DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  crop   Crop   @relation(fields: [cropId], references: [id])
  market Market @relation(fields: [marketId], references: [id])

  @@index([userId])
  @@index([cropId, marketId])
  @@index([isEnabled])
}

enum AlertCondition {
  above
  below
}

// ── CONVERSATIONS ───────────────────────────────────────────
model Conversation {
  id        String   @id @default(cuid())
  user1Id   String
  user2Id   String
  listingId String?
  marketId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user1    User     @relation("ConversationUser1", fields: [user1Id], references: [id])
  user2    User     @relation("ConversationUser2", fields: [user2Id], references: [id])
  listing  Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  market   Market?  @relation(fields: [marketId], references: [id], onDelete: SetNull)
  messages Message[]

  @@unique([user1Id, user2Id, listingId])
  @@index([user1Id])
  @@index([user2Id])
  @@index([listingId])
}

// ── MESSAGES ───────────────────────────────────────────────
model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  text           String    @db.VarChar(4000)
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

# CampusLoop Environment Configuration

# Server Port (default: 5000)
PORT=5000

# SQLite Database File Path (Ensure persistent volume storage in cloud deployments)
DATABASE_PATH=./server/campusloop.db

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Allowed CORS Origins for production deployment (comma-separated, e.g., https://campusloop.app,http://localhost:5173)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000

# Optional: Frontend API Base URL for separate frontend deployments (leave empty for relative /api proxy)
# VITE_API_URL=https://api.campusloop.edu/api

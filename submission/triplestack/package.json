{
  "name": "reliefhub",
  "private": true,
  "version": "1.0.0",
  "description": "ReliefHub - Flood Relief Coordination Dashboard (TripleStack, HacktoberFest 3.0)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:api\" \"npm:web\"",
    "api": "node server/server.js",
    "web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "reset-db": "node server/reset.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "json-server": "0.17.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.1",
    "recharts": "2.15.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.11",
    "@vitejs/plugin-react": "4.6.0",
    "concurrently": "9.2.0",
    "tailwindcss": "4.1.11",
    "vite": "6.3.5"
  }
}

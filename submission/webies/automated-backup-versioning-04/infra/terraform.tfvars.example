# Copy to terraform.tfvars for local overrides. Do not commit terraform.tfvars.

aws_region                        = "us-east-1"
project_name                      = "webies-backup-04"
bucket_prefix                     = "webies-backup-04-"
force_destroy                     = true
noncurrent_version_retention_days = 7
alert_email                       = ""


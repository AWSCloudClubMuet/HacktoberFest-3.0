# App (public) values: copy to .env.local, all pointing at the same Convex deployment.
# `npx convex dev` writes CONVEX_DEPLOYMENT and the two URLs for you.
CONVEX_DEPLOYMENT=dev:your-deployment
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
EXPO_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Backend variables are NOT read from this file. Set them in Convex:
#   npx convex env set NAME value   (or Dashboard > Settings > Environment Variables)
# Declared in convex/convex.config.ts. Never prefix them with EXPO_PUBLIC_.
#
# Required:
# BETTER_AUTH_SECRET=            32+ random chars (openssl rand -base64 32)
# SITE_URL=http://localhost:8081 web origin trusted by Better Auth
# RESEND_API_KEY=re_...          auth codes and price-alert emails
# RESEND_FROM_EMAIL=KisanMandi <alerts@your-verified-domain.com>
#   (onboarding@resend.dev only delivers to the Resend account owner)
# GOOGLE_CLIENT_ID=              Google OAuth web client ID
# GOOGLE_CLIENT_SECRET=          Google OAuth web client secret
#
# AI (optional, used by convex/ai.ts):
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BEARER_TOKEN_BEDROCK=      alternative to the access key pair
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
# See docs/auth-setup.md for Google redirect URLs and the complete auth flow.

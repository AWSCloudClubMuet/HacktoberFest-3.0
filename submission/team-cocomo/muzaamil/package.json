  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.96",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@typesafe-ai/sdk": "^0.7.0",
    "clsx": "^2.1.1",

{
  "name": "campusconnect",
  "private": true,
  "version": "1.0.0",
  "description": "CampusConnect - Campus Gig & SkillSwap Portal (TripleStack, HacktoberFest 3.0)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:api\" \"npm:web\"",
    "api": "node server/server.js",
    "web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "reset-db": "node server/reset-db.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.2.8",
    "express": "5.2.1",
    "lucide-react": "1.48.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.6.0",
    "concurrently": "9.2.0",
    "vite": "6.3.5"
  }
}

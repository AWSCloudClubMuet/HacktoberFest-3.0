{
  "name": "kisanmandi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "seed": "node server/seed.js",
    "api": "json-server --watch server/db.json --port 3001 --host 0.0.0.0",
    "web": "vite --host",
    "dev": "npm run seed && concurrently -k \"npm:api\" \"npm:web\"",
    "dev:noseed": "concurrently -k \"npm:api\" \"npm:web\"",
    "build": "tsc && vite build",
    "test": "vitest run"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@tanstack/react-query": "^5.62.8",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "json-server": "0.17.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.6.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}

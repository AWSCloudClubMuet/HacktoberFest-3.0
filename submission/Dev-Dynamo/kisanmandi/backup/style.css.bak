@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');
:root{--green:#245c3c;--green-dark:#17452c;--green-mid:#34774e;--green-light:#eaf3e9;--cream:#f7f7ef;--paper:#fff;--text:#1d2b22;--muted:#728075;--border:#e1e7de;--amber:#f1b84b;--red:#b93f36;--shadow:0 8px 26px rgba(30,65,41,.06)}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--cream);color:var(--text);font-family:'DM Sans',sans-serif;line-height:1.55}button,input,select{font:inherit}button,a,select{touch-action:manipulation}a{color:inherit}.container{width:min(1180px,calc(100% - 40px));margin:0 auto}.topbar{height:76px;padding:0 max(20px,calc((100% - 1180px)/2));display:flex;align-items:center;justify-content:space-between;background:#fff;border-bottom:1px solid var(--border)}.brand{display:flex;align-items:center;gap:10px;text-decoration:none;font:800 21px Manrope,sans-serif;letter-spacing:-.7px}.brand-mark{display:grid;place-items:center;width:34px;height:34px;border-radius:11px;background:var(--green);color:#fff;font-weight:800}.brand-light{color:var(--green-mid)}.header-actions{display:flex;align-items:center;gap:16px}.demo-pill,.count-pill{font-size:11px;font-weight:700;letter-spacing:.7px;border-radius:30px;padding:6px 10px;background:#f3f0d9;color:#76602b}.role-switch{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--muted)}.role-switch select{border:1px solid var(--border);border-radius:9px;background:white;padding:8px 10px;color:var(--text)}.hero{min-height:310px;margin:30px 0 24px;padding:42px 48px;border-radius:24px;background:linear-gradient(115deg,#e9f2e4,#f8f2dc);display:flex;align-items:center;justify-content:space-between;overflow:hidden;position:relative}.eyebrow{font-size:10px;font-weight:800;letter-spacing:1.8px;color:var(--green-mid);margin:0 0 8px}.hero h1{font:800 clamp(32px,4.2vw,48px)/1.1 Manrope,sans-serif;letter-spacing:-2px;margin:0;color:var(--green-dark)}.hero h1 span{color:#4b8050}.hero-copy{max-width:530px;color:#617263;font-size:15px;margin:17px 0}.hero-meta{display:flex;gap:17px;font-size:11px;color:#617263}.hero-illustration{width:310px;height:225px;position:relative;flex-shrink:0}.sun{position:absolute;right:40px;top:10px;width:70px;height:70px;background:#f3cb65;border-radius:50%}.field{position:absolute;bottom:-70px;width:420px;height:190px;border-radius:50%;transform:rotate(-12deg)}.field-one{background:#9ab88b;right:-90px;bottom:-100px}.field-two{background:#6c9b68;right:-75px;bottom:-125px}.field-three{background:#39754b;right:-35px;bottom:-151px}.crop-icon{position:absolute;right:91px;top:75px;font-size:76px;filter:drop-shadow(0 6px 3px #365b3630)}.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:15px;margin-bottom:48px}.stat-card{display:grid;grid-template-columns:42px 1fr;column-gap:12px;align-items:center;background:#fff;border:1px solid var(--border);border-radius:15px;padding:17px 19px;box-shadow:var(--shadow)}.stat-icon{grid-row:span 2;display:grid;place-items:center;width:40px;height:40px;border-radius:12px;background:var(--green-light);font-size:18px}.stat-label{font-size:11px;color:var(--muted)}.stat-card strong{font:800 24px Manrope,sans-serif}.section{margin:0 0 54px;scroll-margin-top:25px}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:20px}.section-heading h2{font:800 clamp(23px,3vw,29px)/1.2 Manrope,sans-serif;letter-spacing:-.8px;margin:0 0 6px}.section-heading p:not(.eyebrow){margin:0;color:var(--muted);font-size:13px}.btn{border:0;border-radius:10px;padding:11px 15px;font-weight:700;font-size:12px;cursor:pointer;transition:transform .15s,background .15s}.btn:hover{transform:translateY(-1px)}.btn-primary{background:var(--green);color:#fff}.btn-primary:hover{background:var(--green-dark)}.btn-secondary{background:#fff;border:1px solid var(--border);color:var(--green)}.filter-bar{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:10px;margin-bottom:16px}.filter-bar input,.filter-bar select,.listing-filters input,.listing-filters select,.stack-form input,.stack-form select,.filter-row select,.panel>select{width:100%;min-width:0;padding:11px 12px;border:1px solid var(--border);border-radius:10px;background:#fff;color:var(--text);font-size:12px;outline:none}.filter-bar input:focus,.filter-bar select:focus,.listing-filters input:focus,.listing-filters select:focus,.stack-form input:focus,.stack-form select:focus{border-color:#76a47c;box-shadow:0 0 0 3px #dbeadb}.status-message{font-size:12px;color:var(--muted);min-height:18px}.price-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.price-card{background:#fff;border:1px solid var(--border);border-radius:15px;padding:17px;box-shadow:var(--shadow);min-width:0}.price-card-top{display:flex;justify-content:space-between;gap:8px;align-items:center}.category-tag{font-size:10px;color:var(--green);background:var(--green-light);padding:5px 8px;border-radius:30px}.change-pill{font-size:10px;font-weight:700;border-radius:30px;padding:4px 7px;white-space:nowrap}.change-up{color:#247547;background:#e5f4e8}.change-down{color:#b64238;background:#fbe9e5}.change-flat{color:#7b6a37;background:#f7f0d9}.price-card h3{font:700 16px Manrope,sans-serif;margin:15px 0 3px}.price-market{font-size:11px;color:var(--muted)}.price-value{font:800 24px Manrope,sans-serif;letter-spacing:-.7px;margin-top:15px}.price-unit{font-size:11px;color:var(--muted);font-weight:500}.price-date{font-size:10px;color:var(--muted);border-top:1px solid #edf0ea;margin-top:13px;padding-top:10px}.analytics-grid{display:grid;grid-template-columns:1.15fr 1fr;gap:18px}.panel{background:#fff;border:1px solid var(--border);border-radius:16px;padding:22px;box-shadow:var(--shadow);min-width:0}.panel h3{font:700 16px Manrope,sans-serif;margin:0 0 4px}.muted{color:var(--muted);font-size:12px}.panel-heading{display:flex;justify-content:space-between;align-items:start;gap:12px;margin-bottom:16px}.panel-heading p{margin:3px 0 0}.filter-row{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin:15px 0}.chart-wrap{height:220px;width:100%;position:relative}.chart-wrap canvas{width:100%;height:100%;display:block}.summary-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:15px}.summary-item{background:#f7f8f3;border-radius:9px;padding:10px}.summary-item span{display:block;color:var(--muted);font-size:10px}.summary-item strong{font:700 13px Manrope,sans-serif}.table-wrap{overflow-x:auto;margin-top:15px}table{width:100%;border-collapse:collapse;text-align:left;font-size:11px}th{color:var(--muted);font-weight:600;padding:10px 7px;border-bottom:1px solid var(--border)}td{padding:13px 7px;border-bottom:1px solid #edf0ea}tr.best-market td{background:#f0f7ed;font-weight:700}.best-badge{font-size:9px;color:var(--green);display:block}.alerts-layout{display:grid;grid-template-columns:.8fr 1.2fr;gap:18px}.stack-form{display:flex;flex-direction:column;gap:9px}.stack-form label{font-size:11px;font-weight:700;margin-top:3px}.two-fields{display:grid;grid-template-columns:1fr 1fr;gap:10px}.form-message{font-size:12px;color:var(--green);min-height:16px}.alerts-list{display:flex;flex-direction:column;gap:10px}.alert-item{border:1px solid var(--border);border-radius:11px;padding:13px;display:flex;justify-content:space-between;gap:12px;align-items:center}.alert-title{font-weight:700;font-size:12px}.alert-detail{font-size:11px;color:var(--muted);margin-top:4px}.alert-status{font-size:10px;font-weight:700;color:var(--green);margin-top:5px}.alert-triggered{color:#9b4c19;background:#fff0d8;padding:4px 7px;border-radius:30px;display:inline-block}.alert-actions{display:flex;gap:6px;flex-wrap:wrap}.small-btn{border:1px solid var(--border);background:#fff;border-radius:7px;padding:7px 9px;font-size:10px;cursor:pointer}.small-btn:hover{background:#f0f6ed}.marketplace-layout,.profit-layout{display:grid;grid-template-columns:minmax(265px,.75fr) minmax(0,1.4fr);gap:18px;align-items:start}.listing-filters{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:8px;margin:16px 0}.listing-filters input,.listing-filters select{font-size:11px;padding:10px}.listings-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.listing-card{border:1px solid var(--border);border-radius:12px;padding:14px;min-width:0}.listing-card h4{font:700 14px Manrope,sans-serif;margin:0 0 7px;overflow-wrap:anywhere}.listing-price{font:800 19px Manrope,sans-serif;color:var(--green);margin:0 0 8px}.market-price-label{display:inline-block;padding:4px 8px;border-radius:30px;background:#edf4e8;color:#386a35;font-size:9px;font-weight:700}.listing-card p{font-size:11px;margin:8px 0;color:#526156;overflow-wrap:anywhere}.listing-actions{display:flex;flex-wrap:wrap;gap:6px;margin-top:13px}.listing-actions a,.listing-actions button{padding:7px 8px;border:1px solid var(--border);border-radius:7px;background:#fff;color:var(--green);font-size:10px;font-weight:600;text-decoration:none;cursor:pointer}.listing-actions a:hover,.listing-actions button:hover{background:var(--green-light)}.profit-layout{grid-template-columns:minmax(265px,.8fr) minmax(0,1.2fr)}.profit-metric{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:13px 0;border-bottom:1px solid #edf0ea;font-size:12px}.profit-metric strong{text-align:right;overflow-wrap:anywhere}.scenario-heading{margin-top:23px!important}.small-note{line-height:1.6;margin-top:15px}.footer{padding:30px 20px;text-align:center;border-top:1px solid var(--border);background:#fff}.footer-brand{justify-content:center;font-size:17px}.footer-brand .brand-mark{width:28px;height:28px;font-size:15px}.footer p{font-size:11px;color:var(--muted);margin:8px 0 0}.footer .muted{font-size:10px}.empty-state{color:var(--muted);font-size:12px;padding:14px 0;grid-column:1/-1}
@media(max-width:1000px){.price-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.listing-filters{grid-template-columns:repeat(2,minmax(0,1fr))}.hero-illustration{width:240px}.analytics-grid{grid-template-columns:1fr 1fr}}
@media(max-width:760px){.container{width:min(100% - 28px,600px)}.topbar{height:66px;padding:0 14px}.brand{font-size:18px}.header-actions{gap:8px}.demo-pill{display:none}.role-switch{font-size:10px}.role-switch select{padding:7px}.hero{padding:28px 24px;min-height:270px;margin-top:18px}.hero-illustration{position:absolute;right:-95px;bottom:-28px;opacity:.4}.hero>div:first-child{position:relative;z-index:1}.hero-copy{max-width:390px}.stats-grid{grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:36px}.stat-card{padding:13px}.stat-card strong{font-size:21px}.section{margin-bottom:42px}.section-heading{align-items:start}.section-heading .btn{white-space:nowrap}.price-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.analytics-grid,.alerts-layout,.marketplace-layout,.profit-layout{grid-template-columns:1fr}.panel{padding:17px}.listing-filters{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:440px){.hero{padding:25px 19px}.hero h1{font-size:33px}.hero-meta{flex-direction:column;gap:3px}.filter-bar{grid-template-columns:1fr 1fr}.filter-bar input{grid-column:1/-1}.price-grid,.listings-grid{grid-template-columns:1fr}.section-heading h2{font-size:23px}.section-heading p:not(.eyebrow){font-size:12px}.section-heading .btn{padding:9px;font-size:10px}.filter-row,.two-fields{gap:7px}.alert-item{align-items:start}.summary-strip{gap:5px}.summary-item{padding:8px}.summary-item strong{font-size:11px}}

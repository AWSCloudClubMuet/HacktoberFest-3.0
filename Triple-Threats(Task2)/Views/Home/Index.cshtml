@model ReliefHub.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Emergency Operations Dashboard";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <!-- KPI Metric Cards Grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mb-8">
        
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-2xs">
            <span class="text-xs font-bold uppercase text-slate-400">Active Camps</span>
            <div class="text-3xl font-black text-slate-900 mt-1">@Model.ActiveCampsCount</div>
            <span class="text-[11px] text-cyan-600 font-semibold">In 4 districts</span>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-2xs">
            <span class="text-xs font-bold uppercase text-slate-400">Families Sheltered</span>
            <div class="text-3xl font-black text-blue-600 mt-1">@Model.TotalFamiliesSheltered.ToString("N0")</div>
            <span class="text-[11px] text-slate-500">Across registry</span>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-2xs">
            <span class="text-xs font-bold uppercase text-slate-400">Fulfilment</span>
            <div class="text-3xl font-black text-emerald-600 mt-1">@Model.OverallFulfilmentPercentage%</div>
            <span class="text-[11px] text-slate-500">Demand satisfied</span>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-2xs">
            <span class="text-xs font-bold uppercase text-slate-400">Low Stock Alert</span>
            <div class="text-3xl font-black text-rose-600 mt-1">@Model.LowStockItemsCount</div>
            <span class="text-[11px] text-rose-500 font-semibold">At or below reorder</span>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-2xs">
            <span class="text-xs font-bold uppercase text-slate-400">Volunteers</span>
            <div class="text-3xl font-black text-violet-600 mt-1">@Model.VolunteersDeployedCount</div>
            <span class="text-[11px] text-slate-500">Deployed in camps</span>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-2xs">
            <span class="text-xs font-bold uppercase text-slate-400">Cash Received</span>
            <div class="text-2xl font-black text-slate-900 mt-1">PKR @Model.TotalCashDonations.ToString("N0")</div>
            <span class="text-[11px] text-emerald-600 font-semibold">Direct donations</span>
        </div>

    </div>

    <!-- 2 Column Section: Chart & Critical Gaps Table -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Left: Fulfilment Bar Chart -->
        <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-xs flex flex-col justify-between">
            <div>
                <h2 class="text-lg font-bold text-slate-900 mb-1">Fulfilment by Category</h2>
                <p class="text-xs text-slate-500 mb-6">Percentage of required supplies fulfilled per sector</p>
                <canvas id="categoryChart" height="220"></canvas>
            </div>
            <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
                <span>Updated in real time</span>
                <span class="font-bold text-cyan-600">Overall: @Model.OverallFulfilmentPercentage%</span>
            </div>
        </div>

        <!-- Right 2 Cols: Milestone 5 Critical Gaps Table -->
        <div class="lg:col-span-2 bg-white rounded-3xl border border-slate-200 p-6 shadow-xs">
            <div class="flex items-center justify-between mb-4">
                <div>
                    <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full bg-rose-500 animate-ping"></span>
                        Underserved Camps & Critical Gaps (@Model.CriticalGaps.Count)
                    </h2>
                    <p class="text-xs text-slate-500">High-priority needs under 40% fulfilment, ordered by worst shortage</p>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead>
                        <tr class="bg-slate-50 text-slate-400 uppercase font-bold border-b border-slate-100">
                            <th class="p-3">Camp & District</th>
                            <th class="p-3">Critical Supply Need</th>
                            <th class="p-3">Fulfilled / Req</th>
                            <th class="p-3">Progress</th>
                            <th class="p-3 text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var gap in Model.CriticalGaps)
                        {
                            <tr class="hover:bg-rose-50/40 transition-colors">
                                <td class="p-3 font-bold text-slate-900">
                                    <a asp-controller="Camps" asp-action="Details" asp-route-id="@gap.CampId" class="hover:text-cyan-600">
                                        @gap.Camp?.Name
                                    </a>
                                    <span class="block text-[11px] text-slate-400 font-normal">District @gap.Camp?.District</span>
                                </td>
                                <td class="p-3">
                                    <span class="font-bold text-rose-700 bg-rose-50 px-2 py-0.5 rounded border border-rose-200">
                                        @gap.InventoryItem?.Name
                                    </span>
                                    <span class="block text-[10px] text-slate-400 mt-0.5">@gap.InventoryItem?.Category</span>
                                </td>
                                <td class="p-3 font-semibold text-slate-700">
                                    @gap.FulfilledQuantity / @gap.RequiredQuantity @gap.InventoryItem?.Unit
                                </td>
                                <td class="p-3">
                                    <div class="flex items-center gap-2">
                                        <div class="w-24 bg-slate-200 rounded-full h-2">
                                            <div class="bg-rose-600 h-2 rounded-full" style="width: @gap.FulfilmentPercentage%"></div>
                                        </div>
                                        <span class="font-bold text-rose-600">@gap.FulfilmentPercentage%</span>
                                    </div>
                                </td>
                                <td class="p-3 text-right">
                                    <a asp-controller="Dispatches" asp-action="Index" class="px-3 py-1.5 bg-cyan-600 text-white rounded-lg font-bold text-xs hover:bg-cyan-700">
                                        Dispatch Now &rarr;
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

</div>

@section Scripts {
    <script>
        const ctx = document.getElementById('categoryChart').getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryFulfilmentPercentages.Keys)),
                datasets: [{
                    label: 'Fulfilment %',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryFulfilmentPercentages.Values)),
                    backgroundColor: ['#06b6d4', '#3b82f6', '#10b981', '#f59e0b'],
                    borderRadius: 8
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: { beginAtZero: true, max: 100 }
                }
            }
        });
    </script>
}
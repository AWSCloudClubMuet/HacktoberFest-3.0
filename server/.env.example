# Copy this file to server/.env and fill in your own values.
# server/.env is gitignored — never commit real credentials.

# PostgreSQL connection string.
# Set this to use a hosted/local Postgres (required for Better Auth).
# Leave it unset to run on the embedded PGlite database in server/.data/
# with zero setup (auth is disabled in that mode).
DATABASE_URL=postgresql://user:password@your-host:5432/campus_gig?sslmode=require

# Secret used by Better Auth to sign sessions. Use a long random value:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Public URL of the web app (where Better Auth callbacks/cookies live).
BETTER_AUTH_URL=http://localhost:3000

# Optional: API port (default 4000).
# API_PORT=4000
